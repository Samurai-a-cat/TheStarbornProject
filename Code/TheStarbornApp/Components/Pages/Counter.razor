@page "/counter"
@inject IGameSimulation Game
@using TheStarbornApp.GameCore.Services.GameSimulationService
@implements IDisposable

<h1>GameSimulation Timer Test</h1>

@if (_isProcessActive)
{
    var elapsed = _currentElapsed;
    var remaining = Math.Max(0, Duration - elapsed);
    <p>Осталось: <strong>@((int)Math.Ceiling(remaining))</strong> сек</p>
}
else
{
    <p>Процесс не запущен</p>
}

<p>Завершённых циклов: <strong>@_completedCycles</strong></p>

<button class="btn btn-primary" @onclick="StartProcess">Запустить @Duration-секундный процесс</button>

@code {
    private bool _isProcessActive;
    private double _processStartTime;
    private double _currentElapsed;
    private int _completedCycles;
    private const double Duration = 10.0;
    private Timer? _uiRefreshTimer;

    private void StartProcess()
    {
        Game.Update();

        _processStartTime = Game.Calendar.TotalSeconds;
        _isProcessActive = true;
        _currentElapsed = 0;


        StartUiRefresh();
    }

    private void StartUiRefresh()
    {
        _uiRefreshTimer?.Dispose();
        _uiRefreshTimer = new Timer(_ => InvokeAsync(() =>
        {
            if (!_isProcessActive) return;

            Game.Update();
            _currentElapsed = Game.Calendar.TotalSeconds - _processStartTime;

            if (_currentElapsed >= Duration)
            {
                _completedCycles++;
                _isProcessActive = false;
                _uiRefreshTimer?.Dispose();
            }

            StateHasChanged();
        }), null, 0, 500);
    }

    protected override void OnInitialized()
    {
        Game.Update();
    }

    public void Dispose()
    {
        _uiRefreshTimer?.Dispose();
    }
}